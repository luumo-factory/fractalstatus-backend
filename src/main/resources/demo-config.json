{
  "schemes": {
    "node": {
      "online": "oklch(0.56 0.13 152)",
      "warning": "oklch(0.63 0.14 68)",
      "offline": "oklch(0.55 0.17 25)",
      "unknown": "oklch(0.58 0.02 250)"
    }
  },
  "defaultSchemes": {
    "group": "node",
    "entity": "node"
  },
  "theme": {
    "explode": "oklch(0.49 0.06 245)",
    "collapse": "oklch(0.47 0.06 305)"
  },
  "tree": {
    "id": "root",
    "name": "Monitoring Demo",
    "type": "group",
    "display": {
      "icon": "layout-dashboard"
    },
    "values": {
      "pingInterval": 10,
      "pingTimeoutMs": 2000,
      "httpInterval": 30,
      "dnsInterval": 60,
      "dnsServers": [
        "1.1.1.1",
        "8.8.8.8"
      ]
    },
    "children": [
      {
        "id": "connectivity",
        "name": "Internet Connectivity",
        "type": "group",
        "display": {
          "icon": "network"
        },
        "children": [
          {
            "id": "cloudflareDns",
            "name": "Cloudflare DNS",
            "type": "entity",
            "display": {
              "icon": "shield"
            },
            "config": {
              "values": {
                "host": "1.1.1.1"
              },
              "checks": [
                {
                  "name": "ping",
                  "module": "ping",
                  "config": {
                    "host": "${this.host}",
                    "interval": "${this.pingInterval}",
                    "timeoutMs": "${this.pingTimeoutMs}"
                  }
                }
              ],
              "state": {
                "offlineWhen": "ping.reachable == false",
                "warningWhen": "ping.rttMs > 100",
                "fallback": "online"
              }
            }
          },
          {
            "id": "googleDns",
            "name": "Google DNS",
            "type": "entity",
            "display": {
              "icon": "shield"
            },
            "config": {
              "values": {
                "host": "8.8.8.8"
              },
              "checks": [
                {
                  "name": "ping",
                  "module": "ping",
                  "config": {
                    "host": "${this.host}",
                    "interval": "${this.pingInterval}",
                    "timeoutMs": "${this.pingTimeoutMs}"
                  }
                }
              ],
              "state": {
                "offlineWhen": "ping.reachable == false",
                "warningWhen": "ping.rttMs > 100",
                "fallback": "online"
              }
            }
          }
        ]
      },
      {
        "id": "popularWebsites",
        "name": "Popular Websites",
        "type": "group",
        "display": {
          "icon": "globe"
        },
        "children": [
          {
            "id": "search",
            "name": "Search",
            "type": "group",
            "display": {
              "icon": "search"
            },
            "children": [
              {
                "id": "google",
                "name": "Google",
                "type": "entity",
                "display": {
                  "icon": "globe"
                },
                "config": {
                  "values": {
                    "domain": "www.google.com",
                    "url": "https://www.google.com"
                  },
                  "checks": [
                    {
                      "name": "dnsA",
                      "module": "dns",
                      "config": {
                        "domain": "${this.domain}",
                        "type": "A",
                        "servers": "${this.dnsServers}",
                        "interval": "${this.dnsInterval}",
                        "timeout": 5
                      }
                    },
                    {
                      "name": "http",
                      "module": "http",
                      "config": {
                        "url": "${this.url}",
                        "interval": "${this.httpInterval}",
                        "timeout": 10,
                        "expectStatus": 200,
                        "verifySsl": true
                      }
                    }
                  ],
                  "state": {
                    "offlineWhen": "dnsA.resolved == false or http.statusCode != 200 or http.sslValid == false",
                    "warningWhen": "http.responseTimeMs > 2000",
                    "fallback": "online"
                  }
                }
              },
              {
                "id": "bing",
                "name": "Bing",
                "type": "entity",
                "display": {
                  "icon": "globe"
                },
                "config": {
                  "values": {
                    "domain": "www.bing.com",
                    "url": "https://www.bing.com"
                  },
                  "checks": [
                    {
                      "name": "dnsA",
                      "module": "dns",
                      "config": {
                        "domain": "${this.domain}",
                        "type": "A",
                        "servers": "${this.dnsServers}",
                        "interval": "${this.dnsInterval}",
                        "timeout": 5
                      }
                    },
                    {
                      "name": "http",
                      "module": "http",
                      "config": {
                        "url": "${this.url}",
                        "interval": "${this.httpInterval}",
                        "timeout": 10,
                        "expectStatus": 200,
                        "verifySsl": true
                      }
                    }
                  ],
                  "state": {
                    "offlineWhen": "dnsA.resolved == false or http.statusCode != 200 or http.sslValid == false",
                    "warningWhen": "http.responseTimeMs > 2000",
                    "fallback": "online"
                  }
                }
              }
            ]
          },
          {
            "id": "developer",
            "name": "Developer",
            "type": "group",
            "display": {
              "icon": "code"
            },
            "children": [
              {
                "id": "github",
                "name": "GitHub",
                "type": "entity",
                "display": {
                  "icon": "github"
                },
                "config": {
                  "values": {
                    "domain": "github.com",
                    "url": "https://github.com"
                  },
                  "checks": [
                    {
                      "name": "dnsA",
                      "module": "dns",
                      "config": {
                        "domain": "${this.domain}",
                        "type": "A",
                        "servers": "${this.dnsServers}",
                        "interval": "${this.dnsInterval}",
                        "timeout": 5
                      }
                    },
                    {
                      "name": "http",
                      "module": "http",
                      "config": {
                        "url": "${this.url}",
                        "interval": "${this.httpInterval}",
                        "timeout": 10,
                        "expectStatus": 200,
                        "verifySsl": true
                      }
                    }
                  ],
                  "state": {
                    "offlineWhen": "dnsA.resolved == false or http.statusCode != 200 or http.sslValid == false",
                    "warningWhen": "http.responseTimeMs > 2000",
                    "fallback": "online"
                  }
                }
              },
              {
                "id": "stackoverflow",
                "name": "Stack Overflow",
                "type": "entity",
                "display": {
                  "icon": "circle-help"
                },
                "config": {
                  "values": {
                    "domain": "stackoverflow.com",
                    "url": "https://stackoverflow.com"
                  },
                  "checks": [
                    {
                      "name": "dnsA",
                      "module": "dns",
                      "config": {
                        "domain": "${this.domain}",
                        "type": "A",
                        "servers": "${this.dnsServers}",
                        "interval": "${this.dnsInterval}",
                        "timeout": 5
                      }
                    },
                    {
                      "name": "http",
                      "module": "http",
                      "config": {
                        "url": "${this.url}",
                        "interval": "${this.httpInterval}",
                        "timeout": 10,
                        "expectStatus": 200,
                        "verifySsl": true
                      }
                    }
                  ],
                  "state": {
                    "offlineWhen": "dnsA.resolved == false or http.statusCode != 200 or http.sslValid == false",
                    "warningWhen": "http.responseTimeMs > 2000",
                    "fallback": "online"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
